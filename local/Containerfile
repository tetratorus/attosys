FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
ENV container=oci DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd systemd-sysv dbus sudo python3-venv python3-yaml python3-requests python3-aiohttp \
    git curl ca-certificates chromium build-essential && apt-get clean
COPY . /opt/
RUN python3 -m venv --system-site-packages /opt/attosys/venv \
    && /opt/attosys/venv/bin/pip install -r /opt/attobot/requirements.txt -c /opt/attobot/lab-constraints.txt \
    && npm ci --prefix /opt/llmproxy && npm ci --prefix /opt/attobrowser \
    && ln -s /opt/attobot /opt/attosys/harness \
    && ln -s /opt/attobrowser/atto /usr/local/bin/atto
ENV PYTHONDONTWRITEBYTECODE=1
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/lib/systemd/systemd", "--system", "--log-target=console"]
